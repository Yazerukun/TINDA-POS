{
  "darkMode": true,
  "readableLineLength": true,
  "livePreview": true,
  "strictLineBreaks": false,
  "showLineNumber": true,
  "tabSize": 2,
  "useTab": false,
  "autoPairMarkdown": true,
  "autoPairBrackets": true,
  "spellcheck": false,
  "alwaysUpdateLinks": true,
  "attachmentFolderPath": "docs/assets",
  "userIgnoreFilters": [
    "node_modules",
    "source/node_modules",
    "dist",
    "builds",
    "source/dist",
    "source/out",
    ".git"
  ]
}